; Copy to config.ini and fill in. config.ini is gitignored — keep it that way.
[media_tracker]
; YamTracker credentials
username: your-username
password: your-password
URL: https://track.example.com
; Slack app credentials (api.slack.com/apps)
slack_client_id: 000000000000.0000000000000
slack_client_secret: your-client-secret
slack_signing_secret: your-signing-secret
slack_bot_user_oauth_token: xoxb-your-bot-token
; Your Slack member ID (Profile -> Copy member ID)
slack_user_id: U00000000

[navidrome]
; Must match the plugin's shared_secret, set in Navidrome's plugin config UI.
; Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
plugin_shared_secret: change-me
; Relative paths resolve against the repo root (next to this file).
db_path: ratings.db

[lidarr]
; Lidarr instance and API key (Settings -> General -> Security -> API Key).
url: https://lidarr.example.com
api_key: your-lidarr-api-key
; Delete the disliked track's file via Lidarr, and unmonitor its album so
; Lidarr does not re-download it. Set to false to log the plan without acting.
enabled: true

[navidrome_api]
; Subsonic API credentials, used to resolve a track_id to its file path.
; Any Navidrome user works; a read-only account is fine.
url: https://music.example.com
; The same library as two different hosts see it. navidrome_root is the path
; Navidrome reports (shown in its UI under Get Info -> File path, e.g.
; /music/...); music_root is where that tree is mounted ON THE HOST RUNNING
; reap.py. Songs Lidarr does not track are deleted from music_root; leave
; music_root blank to skip those instead.
;
; Navidrome must also be told to report REAL paths over the Subsonic API --
; set ND_SUBSONIC_DEFAULTREPORTREALPATH=true, or enable 'Report Real Path'
; for the media-tracker-reaper player. Without it Navidrome synthesizes
; filenames from tags and nothing will be found on disk.
navidrome_root: /music
music_root: /path/to/music
username: your-navidrome-user
password: your-navidrome-password
